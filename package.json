{
  "name": "@dorks-and-dice/surveyor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js test/detector-parity.test.mjs",
    "start": "node dist/src/main.js",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "typescript": "5.9.3"
  }
}
